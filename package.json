{
  "name": "@drawdb/mcp",
  "version": "0.1.2",
  "description": "MCP server that exposes drawDB diagrams to AI agents (read-only).",
  "type": "module",
  "main": "dist/server.js",
  "license": "MIT",
  "author": "1ilit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drawdb-io/drawdb-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/drawdb-io/drawdb-mcp/issues"
  },
  "homepage": "https://github.com/drawdb-io/drawdb-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "modelcontextprotocol",
    "mcp-server",
    "drawdb",
    "database",
    "database-schema",
    "erd",
    "entity-relationship-diagram",
    "sql",
    "schema",
    "ai",
    "llm",
    "ai-agent",
    "claude",
    "cursor",
    "database-design",
    "drawdb"
  ],
  "bin": {
    "drawdb-mcp": "dist/stdio.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/stdio.js",
    "dev": "tsx --env-file-if-exists=.env src/stdio.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
